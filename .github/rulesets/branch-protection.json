{
  "name": "Branch Protection",
  "target": "branch",
  "enforcement": "active",
  "conditions": {
    "ref_name": {
      "include": [
        "~ALL"
      ],
      "exclude": [
        "refs/heads/[0-9]*-feature-*",
        "refs/heads/[0-9]*-docs-*",
        "refs/heads/[0-9]*-bugfix-*",
        "refs/heads/[0-9]*-hotfix-*",
        "refs/heads/[0-9]*-integration-*",
        "refs/heads/dependabot/**"
      ]
    }
  },
  "bypass_actors": [],
  "rules": [
    {
      "type": "creation"
    },
    {
      "type": "deletion"
    },
    {
      "type": "required_signatures"
    },
    {
      "type": "non_fast_forward"
    }
  ]
}